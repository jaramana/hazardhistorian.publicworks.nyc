n":"no federal declaration covers this event"},"ia_real":{"v":null,"s":"na","u":"$","src":"fema-ia-owners","n":"no federal declaration covers this event"},"nfip_real":{"v":75494,"s":"ok","u":"$","src":"fema-nfip","n":"2024 dollars, CPI-U New York area"}},"damage_property_real":{"v":null,"s":"missing","u":"$","src":"ncei-storm-events"},"damage_crops_real":{"v":null,"s":"missing","u":"$","src":"ncei-storm-events"},"evidence":[{"event_row_id":"414372","hazard":"tornado","ncei_type":"Waterspout","place":"HARBOR","begin":"2012-09-08 09:59:00","end":"2012-09-08 10:01:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":null,"s":"missing","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"NWS Storm Survey","event_narrative":"This is the third segment in a four segment combined waterspout and tornado event. The storm originated as a waterspout about 1 mile south of the tip of Breezy Point around 10:56 am and moved northeast, making landfall about 2500 feet northeast of the tip of Breezy Point, Queens, near the Breezy Point Surf Club, around 10:58 am. The storm then crossed Breezy Point Queens as an EF0 tornado from 10:58 to 10:59 am, before reemerging into the eastern arm of Lower New York Harbor approximately 12500 feet west of Rockaway Inlet. Based on photographic and video evidence showing a waterspout near the southwest and northeast points of the track, and no radar evidence of weakening of the circulation, there is no reason to believe the waterspout was not continuous as it traversed the New York Harbor from 10:59 to 11:01 am. The waterspout then crossed land to the southeast of Plumb Beach in Kings County/Brooklyn about 11:01 am. The EF1 tornado continued northeast to Canarsie, Brooklyn where it lifted at 11:05 am.","lat":40.5605,"lon":-73.927,"note":null},{"event_row_id":"414374","hazard":"thunders