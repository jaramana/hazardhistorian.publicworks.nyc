,"incident":["2007-08-08","2007-08-08"],"events_covered":2}],"assistance":{"scope":"obligated to declaration DR-1724, which is attached to 2 events here, this one among them","pa":{"v":null,"s":"missing","u":"$","src":"fema-pa","n":"declared, but no obligations published"},"ia":{"v":5099617,"s":"ok","u":"$","src":"fema-ia-owners","n":"obligated to declaration DR-1724, which is attached to 2 events here, this one among them"},"nfip":{"paid":{"v":1107911,"s":"ok","u":"$","src":"fema-nfip"},"claims":{"v":70,"s":"ok","src":"fema-nfip"},"by_borough":{"BX":{"v":5381,"s":"ok","u":"$","src":"fema-nfip"},"BK":{"v":20597,"s":"ok","u":"$","src":"fema-nfip"},"MN":{"v":172539,"s":"ok","u":"$","src":"fema-nfip"},"QN":{"v":909394,"s":"ok","u":"$","src":"fema-nfip"}}},"pa_real":{"v":null,"s":"missing","u":"$","src":"fema-pa","n":"declared, but no obligations published"},"ia_real":{"v":7510082,"s":"ok","u":"$","src":"fema-ia-owners","n":"2024 dollars, CPI-U New York area"},"nfip_real":{"v":1631593,"s":"ok","u":"$","src":"fema-nfip","n":"2024 dollars, CPI-U New York area"}},"damage_property_real":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events","n":"2024 dollars, CPI-U New York area"},"damage_crops_real":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events","n":"2024 dollars, CPI-U New York area"},"evidence":[{"event_row_id":"57570","hazard":"heavy-rain","ncei_type":"Heavy Rain","place":"SI","begin":"2007-08-08 04:49:00","end":"2007-08-08 04:49:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Emergency Manager","event_narrative":"Heavy rain and ponding of water caused driver to pull over on the Staten Island Expressway at Bradley Avenue. The vehicle was rear ended.","lat":40.61,"lon":-74.13,"note":null},{"event_row_id":"57491","hazard":"tornado","ncei_type":"Tornado","place":"SI","begin":"2007-08-08 05:22:00","end":"2007-08-08 05:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":"EF1","report_source":"NWS Storm Survey","event_narrative":"The first tornado touchdown was in Staten Island at approximately |6:22 am in the vicinity of St. Austins Place in the Livingston-Randall Manor area. The tornado moved east, with additional damage occurring in the Tompkinsville area. Most of the damage in Staten Island was to trees, and estimated at EF-1 on the Enhanced Fujita Scale, with winds of 86 to 100 mph. ||Based on re-analysis of radar data, the Staten Island tornado apparently dissipated as a second circulation developed just north of the first circulation. The damage in Tompkinsville may be a result of this second circulation.   |","lat":40.627,"lon":-74.1078,"note":null},{"event_row_id":"57520","hazard":"tornado","ncei_type":"Tornado","place":"BK","begin":"2007-08-08 05:32:00","end":"2007-08-08 05:40:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":9,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":"EF2","report_source":"NWS Storm Survey","event_narrative":"This circulation intensified as it moved east across the Verrazano Narrows. The tornado re-developed by the time the circulation moved on shore in Brooklyn. Damage in the form of fallen trees and structural roof damage occurred in Bay Ridge starting in the area from Shore Road between 71st and 78th Streets eastward to Bay Ridge Blvd. This occurred at approximately 6:32 am. The tornado may have briefly lifted and then touched down again on Bay Ridge Avenue between 3rd and 4th Avenues, and continued on an east-northeast path across 68th Street between 3rd and 4th Avenues. Eleven homes in this section had moderate to severe roof damage. The storm continued to move east-northeast into Leif Ericson Park Square, where severe damage to trees occurred. As the tornado lifted, it tore off the roof of the Nissan car dealership at the corner of 66th Street and Fifth Avenue. The tornado returned to the ground farther northeast, with scattered tree damage along 6th avenue. Based on the assessed damage in Bay Ridge, this tornadic damage is classified as EF-2 with estimated wind speeds of 111 to 135 mph.||The tornado returned to the ground as another pocket of significant damage occurred on 58th Street between 5th and 6th Avenues. The roof was ripped off of 5 homes, and tree damage indicated strong EF-1 damage.||The tornado then headed east, and touched down for at least the fourth, but final time, in Kensington just east of the intersection of Church Avenue and Beverly Road at approximately 6:40 am. Numerous trees, approximately 30, were uprooted along Ocean Parkway as the tornado moved east. The tornado produced significant damage to trees and structures in the area with East 8th and 7th Streets being hit hard. Damage was reported as far east as Argyle Road. The tornado was on the ground for approximately 1/2 mile in this area before it lifted.|","lat":40.6155,"lon":-74.0267,"note":null},{"event_row_id":"57525","hazard":"thunderstorm","ncei_type":"Thunderstorm Wind","place":"BK","begin":"2007-08-08 05:41:00","end":"2007-08-08 05:41:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"60.00","magnitude_type":"EG","flood_cause":null,"tor_scale":null,"report_source":"Trained Spotter","event_narrative":"Numerous trees/wires down.","lat":40.63,"lon":-73.99,"note":null},{"event_row_id":"57526","hazard":"thunderstorm","ncei_type":"Thunderstorm Wind","place":"BK","begin":"2007-08-08 05:42:00","end":"2007-08-08 05:42:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"60.00","magnitude_type":"EG","flood_cause":null,"tor_scale":null,"report_source":"Trained Spotter","event_narrative":"Numerous trees and wires down.","lat":40.66,"lon":-73.98,"note":null},{"event_row_id":"57544","hazard":"flash-flooding","ncei_type":"Flash Flood","place":"MN","begin":"2007-08-08 05:43:00","end":"2007-08-08 07:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":"Heavy Rain","tor_scale":null,"report_source":"Emergency Manager","event_narrative":"Torrenial rain resulted in widespread flash flooding.  Lane closures were reported on FDR Drive between 63rd and 78th streets at 6:43 am.  Flooding was reported on Harlem River Drive near 145th Street at 6:46 am.","lat":40.78,"lon":-73.9309,"note":null},{"event_row_id":"57542","hazard":"flash-flooding","ncei_type":"Flash Flood","place":"BK","begin":"2007-08-08 05:43:00","end":"2007-08-08 07:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":"Heavy Rain","tor_scale":null,"report_source":"Emergency Manager","event_narrative":"Flooding on the Brooklyn-Queens Expressway closing multiple lanes.","lat":40.6895,"lon":-73.9516,"note":null},{"event_row_id":"57556","hazard":"flash-flooding","ncei_type":"Flash Flood","place":"QN","begin":"2007-08-08 05:59:00","end":"2007-08-08 07:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":"Heavy Rain","tor_scale":null,"report_source":"Emergency Manager","event_narrative":"Widespread significant flash flooding occurred at many locations throughout Queens.||Severe flooding was reported on the Grand Central Parkway (GCP) at Jackie Robinson Parkway at 6:59 am.  It was also reported on the GCP at the entrance to the Triborough Bridge at 7:05 am.  Severe flooding occurred on the Belt Parkway along 225th Street at 7:36 am and on the Cross Island Parkway near the Throgs Neck Bridge at 7:39 am.","lat":40.72,"lon":-73.8,"note":null},{"event_row_id":"57566","hazard":"flash-flooding","ncei_type":"Flash Flood","place":"BX","begin":"2007-08-08 07:28:00","end":"2007-08-08 07:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":"Heavy Rain","tor_scale":null,"report_source":"Emergency Manager","event_narrative":"Flooding closed the Bronx River Parkway at 233rd Street.","lat":40.8977,"lon":-73.8534,"note":null}]}