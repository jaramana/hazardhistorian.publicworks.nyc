0625660,"s":"ok","u":"$","src":"fema-nfip"},"SI":{"v":234155339,"s":"ok","u":"$","src":"fema-nfip"}}},"pa_real":{"v":7522113071,"s":"ok","u":"$","src":"fema-pa","n":"2024 dollars, CPI-U New York area"},"ia_real":{"v":795308239,"s":"ok","u":"$","src":"fema-ia-owners","n":"2024 dollars, CPI-U New York area"},"nfip_real":{"v":1691878851,"s":"ok","u":"$","src":"fema-nfip","n":"2024 dollars, CPI-U New York area"}},"damage_property_real":{"v":6615694,"s":"ok","u":"$","src":"ncei-storm-events","n":"2024 dollars, CPI-U New York area"},"damage_crops_real":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events","n":"2024 dollars, CPI-U New York area"},"evidence":[{"event_row_id":"421130","hazard":"coastal-flooding","ncei_type":"Coastal Flood","place":"QN","begin":"2012-10-29 07:00:00","end":"2012-10-30 00:00:00","deaths_direct":{"v":7,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Official NWS Observations","event_narrative":"Coastal communities along Southern Queens experienced two successive tidal cycles with at least moderate coastal flooding. The peak of this surge occurred Monday Night as Sandy made landfall in Southern New Jersey, with widespread record coastal flooding occurring along Jamaica Bay exceeding the FEMA 100 year base flood elevations. Peak storm tides surpassed all previously documented high water marks, including the October 31, 1991 and December 11, 1992 nor'easters and the recorded peaks from Hurricane Irene in 2011 and Hurricane Donna in 1960.||The storm tide levels along the Queens shores resulted from a peak storm surge of about 7 to 9 feet that coincided with normal high tides. This resulted in up to 3 to 5 feet of inundation of communities in and along Jamaica Bay. Inundation several blocks inland was experienced across coastal communities such as Howard Beach, Brookville and Inwood. Widespread major residential damage was experienced across areas such as Broad Channel, Meadowmere Park, and Old Howard Beach, where some of the deeper inundation occurred. In addition, JFK Airport experienced 1 to 3 feet of inundation onto portions of their runways.||Across the Rockaways, up to 4 and 7 feet of inundation occurred over the peninsula due to surge from Jamaica Bay on the north side and from surge and wave action from the Atlantic Ocean on the south side. Widespread major damage was experienced across the entire length of the Rockaways, with numerous homes and businesses in Breezy Point, Arverne-Edgemere and Seaside experiencing complete destruction. Atlantic Ocean facing shoreline structures, such as boardwalks and several oceanfront homes were destroyed due to runup and setup on top of storm tide from high wave action of at least 10 to 15 feet from the Atlantic Ocean.||Six fatalities were directly attributed to the storm surge and high surf in Queens.","lat":null,"lon":null,"note":null},{"event_row_id":"421109","hazard":"coastal-flooding","ncei_type":"Coastal Flood","place":"BK","begin":"2012-10-29 07:00:00","end":"2012-10-30 00:00:00","deaths_direct":{"v":5,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Official NWS Observations","event_narrative":"Coastal communities along Southern Brooklyn experienced two successive tidal cycles with at least moderate coastal flooding. The peak of this surge occurred Monday Night as Sandy made landfall in Southern New Jersey, with widespread record coastal flooding occurring along New York Harbor and Jamaica Bay exceeding the FEMA 100 year base flood elevations. Peak storm tides surpassed all previously documented high water marks, including the October 31, 1991 and December 11, 1992 nor'easters and the recorded peaks from Hurricane Irene in 2011 and Hurricane Donna in 1960. ||The storm tide levels along the Brooklyn shores resulted from a peak storm surge of about 7 to 10 feet that coincided with normal high tides. These storm tides resulted in up to 3 to 5 feet of inundation along the northeastern and southern coasts of Brooklyn.||The hardest hit area in Northeast Brooklyn was Red Hook getting inundated from Upper New York Bay. Additionally, other areas hard hit were Greenpoint and Williamsburg from inundation of Newtown Creek; and Brooklyn Heights from inundation of the East River and Upper New York Bay. ||In southwest Brooklyn; the shoreline communities including Sea Gate, Coney Island, and Manhattan Beach, experienced significant inundation from storm tide and wave action. Numerous homes in this area experienced major structural damage. Inundation extended inland to Avenue X into Bensonhurst, Gravesend and Sheepshead Bay, shutting down the Belt Parkway.||In southeast Brooklyn, the hardest hit areas were Gerritsen Beach, Floyd Bennet, Bergen Beach, Mill Basin, and Canarsie due to inundation from Jamaica Bay and Rockaway Inlet several blocks inland.||Five fatalities were directly attributed to the surge in Brooklyn.","lat":null,"lon":null,"note":null},{"event_row_id":"420465","hazard":"coastal-flooding","ncei_type":"Coastal Flood","place":"MN","begin":"2012-10-29 07:18:00","end":"2012-10-30 00:07:00","deaths_direct":{"v":2,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Official NWS Observations","event_narrative":"Southern, Eastern and Western portions of Manhattan experienced two successive tidal cycles with at least moderate coastal flooding. The peak of this surge occurred Monday Night as Sandy made landfall in Southern New Jersey, with widespread record coastal flooding occurring in Lower New York Harbor exceeding the FEMA 100 year base flood elevations. Peak storm tides surpassed all previously documented high water marks, including the October 31, 1991 and December 11, 1992 nor'easters and the recorded peaks from Hurricane Irene in 2011 and Hurricane Donna in 1960.||The record storm tide levels along the south shore of New York City resulted from a peak storm surge of about 8 to 10 feet that coincided with normal high tides. These storm tides resulted in up to 3 to 6 feet of inundation along the south shore of Manhattan, with up to 2 to 4 feet of inundation along the East River and Hudson River neighborhoods.||Two fatalities were attributed to the storm surge in Manhattan.","lat":null,"lon":null,"note":null},{"event_row_id":"420534","hazard":"coastal-flooding","ncei_type":"Coastal Flood","place":"SI","begin":"2012-10-29 07:18:00","end":"2012-10-30 00:07:00","deaths_direct":{"v":23,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Official NWS Observations","event_narrative":"Widespread record coastal flooding occurred in Lower New York Harbor exceeding the FEMA 100 year base flood elevations.  Peak storm tides surpassed all previously documented high water marks, including the October 31, 1991 and December 11, 1992 nor'easters and the recorded peaks from Hurricane Irene in 2011 and Hurricane Donna in 1960.||The record storm tide levels along the Eastern Shore of Staten Island resulted from a peak storm surge of about 9 to 11 feet that coincided with normal high tides. These storm tides in conjunction with several feet of wave action resulted in up to 5 to 8 feet of inundation along the northeast coast of Staten Island. Townships such as South Beach, Midland Beach, New Dorp, Oakwood Beach, and Great Kills sustained widespread major property damage and loss of life.||Up to 4 to 6 feet of inundation was experienced across the southeast tip of Staten Island, with 2 to 6 feet of inundation along the Arthur Kill in Western Staten Island.||Twenty three fatalities were directly attributed to the storm surge and high surf in Staten Island.","lat":null,"lon":null,"note":null},{"event_row_id":"421136","hazard":"coastal-flooding","ncei_type":"Coastal Flood","place":"QN","begin":"2012-10-29 09:30:00","end":"2012-10-30 00:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Official NWS Observations","event_narrative":"Coastal communities along Northern Queens experienced two successive tidal cycles  with at least moderate coastal flooding. The peak of this surge occurred Monday Night as Sandy made landfall in Southern New Jersey, with widespread major coastal flooding occurring along Western Long Island Sound. Peak storm tides surpassed water levels from the October 31, 1991 and December 11, 1992 nor'easters and the recorded peaks from Hurricane Irene in 2011. The storm tide levels in Western Long Island Sound resulted from a peak storm surge of about 8 to 10 feet that coincided with normal high tides.||These storm tides resulted in up to 3 to 6 feet of inundation within a few blocks of the East River and Newtown Creek in Hunters Point as well as Astoria along the East River. ||Additionally, 2 to 4 feet of inundation was observed over runway 13 and the northern portion of runway 22 at LaGuardia Airport, with water making it all the way to the terminal building.","lat":null,"lon":null,"note":null},{"event_row_id":"420710","hazard":"coastal-flooding","ncei_type":"Coastal Flood","place":"BX","begin":"2012-10-29 09:30:00","end":"2012-10-30 00:30:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":null,"magnitude_type":null,"flood_cause":null,"tor_scale":null,"report_source":"Official NWS Observations","event_narrative":"Coastal communities along the Bronx experienced two successive tidal cycles with at least moderate coastal flooding. The peak of this surge occurred Monday Night as Sandy made landfall in Southern New Jersey, with widespread major coastal flooding occurring along Western Long Island Sound. Peak storm tides surpassed water levels from the October 31, 1991 and December 11, 1992 nor'easters and the recorded peaks from Hurricane Irene in 2011. The major storm tide levels in Western Long Island Sound resulted from a peak storm surge of about 8 to 10 feet that coincided with normal high tides. ||These storm tides resulted in up to 2 to 4 feet of inundation several blocks inland along Long Island Sound, East River and Harlem River and in adjacent communities in areas such as Harding Park, Port Morris, Mott Haven, Locust Point, Clason Point, City Island and Edgewater Park. Two or more Harding Park homes were condemned and a handful of Edgewater Park homes were completely destroyed. Flood waters also surged in Mott Haven late Monday, inundating the intersection of Bruckner Blvd. and Alexander Ave. for several hours. Warehouses and monuments in Port Morris suffered water damage.","lat":null,"lon":null,"note":null},{"event_row_id":"413127","hazard":"high-winds","ncei_type":"High Wind","place":"SI","begin":"2012-10-29 13:00:00","end":"2012-10-29 22:00:00","deaths_direct":{"v":1,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":1000000,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"70.00","magnitude_type":"EG","flood_cause":null,"tor_scale":null,"report_source":"Emergency Manager","event_narrative":"Many trees were downed due to the high winds. Winds ranged from 60 to 80 mph across the area during the late afternoon and through the evening hours.","lat":null,"lon":null,"note":null},{"event_row_id":"413123","hazard":"high-winds","ncei_type":"High Wind","place":"MN","begin":"2012-10-29 14:00:00","end":"2012-10-29 22:00:00","deaths_direct":{"v":1,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":1000000,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"54.00","magnitude_type":"MG","flood_cause":null,"tor_scale":null,"report_source":"ASOS","event_narrative":"A wind gust up to 62 mph was measured in Central Park at 313 pm. A 30 year old man was found dead apparently trapped underneat a tree inside his home at 166th street due to the winds. Another man of unknown age was trapped underneath a downed tree in his home in Upper Manhattan due to the high winds. A woman of unknown age died when power was cut to her home, cutting off her oxygen supply due to the winds.","lat":null,"lon":null,"note":null},{"event_row_id":"416831","hazard":"high-winds","ncei_type":"High Wind","place":"BX","begin":"2012-10-29 17:00:00","end":"2012-10-29 22:00:00","deaths_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":0,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"64.00","magnitude_type":"MG","flood_cause":null,"tor_scale":null,"report_source":"ASOS","event_narrative":"A wind gust of 74 mph was measured at LaGuardia Airport at 655 pm.","lat":null,"lon":null,"note":null},{"event_row_id":"413125","hazard":"high-winds","ncei_type":"High Wind","place":"QN","begin":"2012-10-29 17:00:00","end":"2012-10-29 21:00:00","deaths_direct":{"v":1,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":1000000,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"69.00","magnitude_type":"EG","flood_cause":null,"tor_scale":null,"report_source":"Mesonet","event_narrative":"A wind gust up to 79 mph was reported near Jackson Heights at 802 pm.  In addition, a wind gust up to 74 mph was measured at LaGuardia Airport at 655 pm. In Flatbush, a 30 year old male was killed when a tree fell onto his house.","lat":null,"lon":null,"note":null},{"event_row_id":"413120","hazard":"high-winds","ncei_type":"High Wind","place":"BK","begin":"2012-10-29 17:00:00","end":"2012-10-29 23:00:00","deaths_direct":{"v":2,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":1000000,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"60.00","magnitude_type":"EG","flood_cause":null,"tor_scale":null,"report_source":"Mesonet","event_narrative":"A wind gust up to 69 mph was reported in Coney Island at 642 pm, and winds of 58 mph were reported in Flatbush at 905 pm. A male and female, both age 24, were killed when a tree fell on them.","lat":null,"lon":null,"note":null},{"event_row_id":"413126","hazard":"high-winds","ncei_type":"High Wind","place":"QN","begin":"2012-10-29 18:00:00","end":"2012-10-29 22:00:00","deaths_direct":{"v":3,"s":"ok","src":"ncei-storm-events"},"injuries_direct":{"v":0,"s":"ok","src":"ncei-storm-events"},"damage_property":{"v":1000000,"s":"ok","u":"$","src":"ncei-storm-events"},"magnitude":"74.00","magnitude_type":"EG","flood_cause":null,"tor_scale":null,"report_source":"ASOS","event_narrative":"A wind gust up to 85 mph was reported at JFK International Airport at 802 PM. Wind gusts up to 78 MPH were reported at Breezy Point at 830 PM.","lat":null,"lon":null,"note":null}]}